APP_NAME="Cassio Finance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_BIND=127.0.0.1
APP_PORT=8080
TRUSTED_PROXIES=REMOTE_ADDR

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === Banco de dados (MySQL no host — fora do Docker) ===
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=app_cassio
DB_USERNAME=
DB_PASSWORD=

# === Cache, sessão e fila (Redis containerizado) ===
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# === Cloudflare Tunnel (opcional em produção) ===
# Preencha apenas no VPS se for rodar `docker compose --profile tunnel up -d`.
CLOUDFLARED_TOKEN=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@cassio.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

CHATWOOT_BASE_URL=https://msa.vozconecta.com.br
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_INBOX_ID=15
CHATWOOT_ASSIGNEE_ID=4
